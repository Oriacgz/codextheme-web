# Prisma Postgres: connect the free integration in Vercel Marketplace.
# Use its native postgres:// or postgresql:// connection URL (not prisma+postgres).
# Vercel's codexthemelibrary_POSTGRES_URL is also supported; use either key.
DATABASE_URL=""
# Exact production origin, without a trailing slash.
APP_ORIGIN="https://your-project.vercel.app"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Create a PRIVATE Vercel Blob store. Do not use a public store for raw uploads.
BLOB_READ_WRITE_TOKEN=""


# Render: set NODE_ENV=production in the dashboard. PORT is supplied by Render.
